rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista delle email autorizzate ad accedere al sito.
    function isEmailAutorizzata() {
      return request.auth != null 
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'kataxsecret@gmail.com',
          'andyplay95@gmail.com',
          'cliente2@gmail.com'
        ];
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kataxsecret@gmail.com';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isEmailAutorizzata() && (request.auth.uid == uid || isAdmin());
    }
  }
}